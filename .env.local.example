# Turso Database Configuration
# Copy this file to .env.local and fill in your actual values

# Turso Database URL - Get from: https://turso.tech/app
# Example: libsql://your-database-name.turso.io
TURSO_DATABASE_URL=your_turso_database_url_here

# Turso Auth Token - Get from: turso db tokens create <database-name>
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Instructions:
# 1. Sign up at https://turso.tech
# 2. Create a new database: turso db create notam-qcode-db
# 3. Get the database URL: turso db show notam-qcode-db
# 4. Generate an auth token: turso db tokens create notam-qcode-db
# 5. Copy this file to .env.local and paste your credentials
